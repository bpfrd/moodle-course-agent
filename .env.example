# Moodle web-service endpoint and credentials
BASE_URL=https://your-moodle.example.org/webservice/rest/server.php
WSTOKEN=your-moodle-wstoken
COURSE_ID=12345

# Set to 1 to run against an in-memory demo course (no live Moodle)
MOODLE_MOCK=0

# LLM: openai (default) or bedrock
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# MODEL_PROVIDER=bedrock
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Topic/safety classifier run before each turn
# GUARDRAIL_ENABLED=1
# Cheaper classifier model on the same provider (default: reuse the chat model)
# GUARDRAIL_MODEL=gpt-4o-mini
# Allow the turn if the classifier errors (default: refuse it)
# GUARDRAIL_FAIL_OPEN=0

# Local course workspace and persisted snapshots/sessions
WORKSPACE_DIR=workspace
DATA_DIR=data
SKILLS_DIR=skills

# Hidden/reference section that holds reusable templates
TEMPLATE_SECTION_NAME=Modulentwicklung [RK only]

# Strands OpenTelemetry → local Langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
# OTEL_CONSOLE=0
